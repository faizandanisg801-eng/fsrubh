{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Frontend is static HTML/CSS/JS, no build step needed.'",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
